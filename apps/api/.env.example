NODE_ENV=development
PORT=4000

# Paste your Postgres connection string here (Neon/Supabase/local).
#
# Using Supabase? Use the POOLED connection string, not the direct one:
# Project Settings -> Database -> Connection string -> "Connection pooling"
# (Session mode). The direct host (db.<ref>.supabase.co) is IPv6-only on
# the free tier and will time out (P1001) on most home/office networks.
# Pooled host looks like: aws-0-<region>.pooler.supabase.com, port 5432,
# username postgres.<project-ref> (not just "postgres").
#
# Any special characters in your password (@, $, etc.) must be percent-
# encoded: @ -> %40, $ -> %24, otherwise the URL parser misreads it.
DATABASE_URL="postgresql://user:password@host:5432/schoolsaas?schema=public"

# openssl rand -base64 32
JWT_SECRET="change-me-dev-secret"
JWT_REFRESH_SECRET="change-me-dev-refresh-secret"

FRONTEND_URL="http://localhost:3000"
